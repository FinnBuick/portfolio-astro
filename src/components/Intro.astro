---
import headshotImage from "../assets/headshot.jpg";
import { Image } from "astro:assets";
---

<header class="intro">
  <div class="intro-left">
    <h1 class="intro__hello">Hi, I'm Finn,</h1>
    <p class="intro__tagline">
      I'm a software engineer based in Sydney. I like to learn, solve problems
      and build useful things.
    </p>
    <p class="intro__contact">
      Get in touch{" "}
      <span class="sm-view" role="img" aria-label="emoji"> 👇</span>
      <span class="lg-view" role="img" aria-label="emoji"> 👉</span>{" "}
      <a class="left" href="mailto:finnbuick@gmail.com"> finnbuick@gmail.com</a>
    </p>
  </div>
  <div class="intro-right">
    <Image
      class="intro__image"
      src={headshotImage}
      height={400}
      width={400}
      densities={[1.5, 2]}
      quality={80}
      alt="Finn Buick"
      loading="eager"
    />
  </div>
</header>
